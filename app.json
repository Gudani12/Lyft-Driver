{
  "expo": {
    "name": "Lyft Driver",
    "slug": "hopon-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hopon.logo.square.png",
    "scheme": "lyft-driver",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAdcAcSAcCqwKkIBdD5dylxayliczX2TsU"
      }
    },

    "android": {
      "package": "com.hopon.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1D1135",
        "foregroundImage": "./assets/images/hopon.apk.logo.square.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAdcAcSAcCqwKkIBdD5dylxayliczX2TsU"
        }
      }
    },

    "web": {
      "output": "server",
      "favicon": "./assets/images/hopon.logo.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hopon.logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1D1135",
          "dark": {
            "image": "./assets/images/hopon.logo.png",
            "backgroundColor": "#1D1135"
          }
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "@didit-protocol/sdk-react-native",
      "./plugins/withAndroidBackupRulesManifest",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.lyft",
          "enableGooglePay": true
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },

    "extra": {
      "eas": {
        "projectId": "d17b3869-d9fb-4162-ab98-5f753caecf0c"
      }
    }
  }
}
